{
  "id": "hypersonic2",
  "name": "Hypersonic 2",
  "abbrev": "HS2",
  "version": "0.1.0",
  "description": "Hypersonic 2 engine port: four multitimbral parts, every patch and element editable. Needs your own Hypersonic 2 content folder.",
  "author": "HS2 Port",
  "license": "Personal use",
  "ui": "ui.js",
  "ui_chain": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "assets": {
    "path": "content",
    "label": "Hypersonic 2 Content",
    "allowFolders": true,
    "description": "Requires the Hypersonic 2 content folder (Patches, Samples, Wavetables, Drawbars, Effects, Tunings).",
    "hint": "Copy the contents of your 'Hypersonic 2 Content' folder here, so that content/Patches and content/Samples exist. Nothing from Steinberg ships with this module.",
    "folders": [
      { "path": "Patches", "label": "Patch banks", "description": "The NNN patch bank files", "required": true },
      { "path": "Samples", "label": "Sample banks", "description": "The NNN sample bank files", "required": true },
      { "path": "Wavetables", "label": "Wavetables", "required": false },
      { "path": "Drawbars", "label": "Drawbars", "required": false },
      { "path": "Effects", "label": "Effect presets", "description": "For the global effect slots", "required": false },
      { "path": "Tunings", "label": "Microtunings", "required": false }
    ]
  },
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "aftertouch": true,
    "midi_channels": 16,
    "chainable": true,
    "component_type": "sound_generator",
    "requires_continuous_processing": true,
    "default_forward_channel": -2,
    "chain_params": [
      { "key": "hk1", "name": "Hyperknob 1", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0 },
      { "key": "hk2", "name": "Hyperknob 2", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0 },
      { "key": "hk3", "name": "Hyperknob 3", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0 },
      { "key": "hk4", "name": "Hyperknob 4", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0 },
      { "key": "hk5", "name": "Hyperknob 5", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0 },
      { "key": "hk6", "name": "Hyperknob 6", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0 },
      { "key": "level", "name": "Part Level", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.7 },
      { "key": "pan", "name": "Part Pan", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.5 },
      { "key": "preset", "name": "Patch", "type": "int", "min": 0, "max_param": "preset_count", "default": 0 }
    ]
  }
}
